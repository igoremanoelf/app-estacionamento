# Origem dos dados:
#   local    = base de dados no dispositivo com dados de demonstração (não precisa de Firebase)
#   firebase = Cloud Firestore + Firebase Authentication (preencher as variáveis abaixo)
EXPO_PUBLIC_DATA_MODE=local

# Copie para .env e preencha com os dados do seu projeto Firebase
# (Consola Firebase > Definições do projeto > As suas apps > Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# true = fotos de perfil no Firebase Storage (requer plano Blaze).
# false = fotos guardadas comprimidas (base64) no documento do utilizador no Firestore.
EXPO_PUBLIC_USE_STORAGE=false

# Opcional: projectId do EAS, necessário para obter o token de push remoto (Expo Push).
EXPO_PUBLIC_EAS_PROJECT_ID=
